# PDF_LLM_OCR_PROVIDER waehlt den Vision-LLM-Provider: "anthropic" (Default) oder "openai".
# Es wird nur der API-Key des gewaehlten Providers gebraucht.
PDF_LLM_OCR_PROVIDER=anthropic

ANTHROPIC_API_KEY=
PDF_LLM_OCR_MODEL=claude-sonnet-5

OPENAI_API_KEY=
PDF_LLM_OCR_OPENAI_MODEL=gpt-5.5

PDF_LLM_OCR_DPI=300
PDF_LLM_OCR_TESS_LANG=deu+eng
PDF_LLM_OCR_MAX_REF_CHARS=8000
PDF_LLM_OCR_MIN_ALIGNMENT_COVERAGE=0.5
